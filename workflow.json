    {
      "parameters": {
        "sendTo": "client@example.com",
        "subject": "=Viral Video Shortlist - {{ $now.toFormat(\"MMMM d, yyyy\") }}",
        "message": "=<html><head><style>body{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;line-height:1.6;color:#1f2937;background:#f9fafb;margin:0;padding:0}.container{max-width:800px;margin:0 auto;background:#fff}.header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:40px 30px;text-align:center}.header h1{margin:0 0 10px 0;font-size:32px;font-weight:700}.header p{margin:5px 0;opacity:.95;font-size:16px}.summary{background:#f3f4f6;padding:20px 30px;border-bottom:3px solid #667eea}.summary-stat{display:inline-block;margin-right:30px}.summary-stat strong{color:#667eea;font-size:24px;display:block}.video-card{margin:0;padding:30px;border-bottom:1px solid #e5e7eb}.video-card:last-child{border-bottom:none}.video-rank{display:inline-block;background:#667eea;color:#fff;font-weight:700;font-size:18px;padding:8px 16px;border-radius:8px;margin-bottom:15px}.video-title{font-size:22px;font-weight:600;color:#111827;margin:10px 0 15px 0;line-height:1.3}.video-title a{color:#111827;text-decoration:none}.video-title a:hover{color:#667eea}.channel-info{color:#6b7280;font-size:14px;margin:10px 0}.channel-info a{color:#667eea;text-decoration:none;font-weight:600}.channel-info a:hover{text-decoration:underline}.video-meta{background:#f9fafb;padding:15px;border-radius:8px;margin:15px 0;display:flex;flex-wrap:wrap;gap:20px}.meta-item{flex:1;min-width:100px}.meta-label{font-size:11px;text-transform:uppercase;color:#6b7280;font-weight:600;letter-spacing:.5px}.meta-value{font-size:18px;font-weight:700;color:#111827;margin-top:4px}.viral-badge{display:inline-block;background:linear-gradient(135deg,#f59e0b 0%,#ef4444 100%);color:#fff;padding:6px 14px;border-radius:20px;font-weight:700;font-size:14px}.video-link{display:inline-block;background:#667eea;color:#fff;text-decoration:none;padding:10px 20px;border-radius:6px;font-weight:600;margin:10px 0}.video-link:hover{background:#5568d3}.content-section{margin-top:20px}.section-title{font-size:15px;font-weight:700;color:#374151;margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px}.section-content{background:#f9fafb;padding:18px;border-left:4px solid #667eea;border-radius:4px;line-height:1.7;color:#374151;font-size:14px}.footer{background:#1f2937;color:#9ca3af;text-align:center;padding:30px;font-size:13px}</style></head><body><div class=\"container\"><div class=\"header\"><h1>🎬 Viral Video Shortlist Report</h1><p>{{ $now.toFormat(\"EEEE, MMMM d, yyyy\") }}</p></div><div class=\"summary\"><div class=\"summary-stat\"><strong>{{ $json.videos.length }}</strong><span>Videos Analyzed</span></div><div class=\"summary-stat\"><strong>{{ $json.videos.reduce((sum, v) => sum + v.views, 0).toLocaleString() }}</strong><span>Total Views</span></div><div class=\"summary-stat\"><strong>{{ ($json.videos.reduce((sum, v) => sum + v.viral_score, 0) / $json.videos.length).toFixed(1) }}</strong><span>Avg Viral Score</span></div></div>{{ $json.videos.map((v, i) => '<div class=\"video-card\"><span class=\"video-rank\">#' + (i + 1) + '</span><h2 class=\"video-title\"><a href=\"' + v.video_url + '\" target=\"_blank\">' + v.video_title + '</a></h2><p class=\"channel-info\">📺 <a href=\"' + (v.channel_url || \"#\") + '\" target=\"_blank\">' + v.channel_name + '</a></p><div class=\"video-meta\"><div class=\"meta-item\"><div class=\"meta-label\">Viral Score</div><div class=\"meta-value\"><span class=\"viral-badge\">' + v.viral_score.toFixed(2) + '</span></div></div><div class=\"meta-item\"><div class=\"meta-label\">Views</div><div class=\"meta-value\">👁️ ' + v.views.toLocaleString() + '</div></div><div class=\"meta-item\"><div class=\"meta-label\">Likes</div><div class=\"meta-value\">👍 ' + v.likes.toLocaleString() + '</div></div><div class=\"meta-item\"><div class=\"meta-label\">Comments</div><div class=\"meta-value\">💬 ' + v.comments.toLocaleString() + '</div></div></div><a href=\"' + v.video_url + '\" class=\"video-link\" target=\"_blank\">▶️ Watch Video</a><div class=\"content-section\"><div class=\"section-title\">📝 Summary</div><div class=\"section-content\">' + v.summary + '</div></div><div class=\"content-section\"><div class=\"section-title\">💬 Ready-to-Use Comment</div><div class=\"section-content\">' + v.ready_comment + '</div></div><div class=\"content-section\"><div class=\"section-title\">🔄 Reshare Caption</div><div class=\"section-content\">' + v.reshare_caption + '</div></div><div class=\"content-section\"><div class=\"section-title\">✨ Original Content Draft</div><div class=\"section-content\">' + v.original_content + '</div></div></div>').join(\"\") }}</div></body></html>",
        "options": {
          "appendAttribution": false
        }
      },
